# Database (MongoDB Atlas connection string, database naam /talktotext)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/talktotext

# Login token ka secret (lambi random string, 48 bytes hex)
JWT_SECRET=replace_with_a_long_random_string

# Groq API key (console.groq.com)
GROQ_API_KEY=replace_with_your_groq_key

# Plan IDs (abhi placeholder, payment provider judne par asli IDs aayengi)
PLAN_BASIC_ID=PLACEHOLDER_BASIC
PLAN_PRO_ID=PLACEHOLDER_PRO

# Frontend ka address (CORS ke liye). Local par default http://localhost:5173
CLIENT_URL=http://localhost:5173

# Production par "production" set karo (secure cookies ke liye)
NODE_ENV=development